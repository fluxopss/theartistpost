# PostgreSQL — temp VPS Docker DB (framework for local wiring)
# Prod later: Neon / managed Postgres. Do not commit real passwords.
#
# VPS container: theartistpost-postgres on flux-vps (:5433)
# Compose: /opt/apps/theartistpost/docker-compose.yml
# Password lives on VPS: /opt/apps/theartistpost/.env (chmod 600)
#
# Direct (UFW-restricted to Flux Hub IP):
DATABASE_URL="postgresql://theartistpost:PASSWORD@2.25.206.39:5433/theartistpost?schema=public"
#
# Or SSH tunnel (more locked down — bind VPS to 127.0.0.1 only):
#   ssh -N -L 5433:127.0.0.1:5433 flux-vps
#   DATABASE_URL="postgresql://theartistpost:PASSWORD@127.0.0.1:5433/theartistpost?schema=public"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="The Artist Post"
CONTENT_ADAPTER="seed"

# GoHighLevel inbound webhook for Get Involved inquiries (fail closed in production)
# GHL_WEBHOOK_URL="https://services.leadconnectorhq.com/hooks/..."

# Flux Pulse — first-party traffic (pk_artistpost in flux-pulse/sites.json)
NEXT_PUBLIC_PULSE_URL="https://pulse.fluxlab.agency"
NEXT_PUBLIC_PULSE_KEY="pk_artistpost"

# Session cookie HMAC (passwordless join). Prefer AUTH_SECRET.
# Falls back to NEXTAUTH_SECRET if set. Production writes fail closed without one.
# Local/dev: if neither is set, a fixed non-production fallback is used.
AUTH_SECRET="generate-a-long-random-string"

# Mobile / returning-user sign-in codes (POST /api/v1/auth/request-code).
# Also used by the web /join returning door (server actions → tap_session cookie).
# POST JSON { email, code, purpose, product } to this webhook for delivery
# (Zapier, GHL, Resend worker, etc.). Required on the live host for sign-in codes.
# AUTH_CODE_WEBHOOK_URL="https://hooks.example.com/artistpost-auth-code"
#
# Dev only: echo the code in the API response (never set on the live host).
# AUTH_CODE_ECHO=1

# Returning door path: HMAC codes today (above). After Auth PR #15 merges and
# /api/v1/auth/link + Supabase JWKS are live on the VPS, set URL + publishable
# key and flip SUPABASE_RETURNING_OTP=1 to prefer Supabase email OTP → /auth/link.
# Partial env alone never switches the door — HMAC stays the working path.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_JWKS_URL=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_RETURNING_OTP=1

# TODO: NextAuth — plug in when ready (passwordless / magic-link later)
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET=""
# Public join: /join (Member VIEWER, Artist pending, or Returning code). No OPERATOR_SECRET required.
# Invite approved artists (operator) via:
#   pnpm invite:artist -- --email real@example.com --handle handle --name "Real Name"
# or server action inviteArtistAction({ email, handle, name, operatorSecret }).
#
# Mobile auth: POST /api/v1/auth/join | request-code | verify | refresh | logout | GET me
# Web returning door: requestSignInCodeAction / verifySignInCodeAction → tap_session
# Studio: POST /api/v1/studio/media | GET+POST /api/v1/studio/posts
# Authorization: Bearer <token>
#   - Supabase Auth access JWT (preferred) — verified via SUPABASE_JWKS_URL
#   - or house HMAC (same format as tap_session cookie) during transition
# Link Prisma User after Supabase sign-in: POST /api/v1/auth/link

# Supabase Auth (hybrid — Auth only; domain data stays on Prisma/VPS Postgres).
# Never commit the secret key. Publishable key is safe for browser/Expo clients.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
# NEXT_PUBLIC_SUPABASE_URL=   # alias for clients / Expo
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=  # server-only; never ship to clients

# Operator invite secret (required for invite:artist / inviteArtistAction only)
# OPERATOR_SECRET="generate-a-long-random-string"

# Optional: OPERATOR_UNLOCK=1 would unlock drafts-only create UI — not enabled.
# Create stays closed until ArtistProfile.approved = true.

# Expo Go tunnel for /setup-expo and GET /api/v1/app/expo-dev.
# Set on the VPS after Metro restarts (`npx expo start --tunnel --go`), then
# restart pm2 so Next reloads env. Accepts exp:// or https:// …exp.direct.
# EXPO_DEV_TUNNEL_URL="exp://t0w5g0w-anonymous-8081.exp.direct"
# EXPO_GO_URL is an alias for the same value.
# Optional ISO timestamp shown on the setup page:
# EXPO_DEV_UPDATED_AT="2026-09-29T02:00:00.000Z"

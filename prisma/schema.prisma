generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VIEWER
  ARTIST
  ADMIN
}

enum MediaType {
  IMAGE
  VIDEO
  EMBED
  CANVAS
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AuthChallengePurpose {
  SIGN_IN
}

enum CommunityKind {
  SHOUTOUT
  COLLAB
  SHOWING
  ASK
  KINDNESS
  UPDATE
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  REPLY
  SUPPORT
  MENTION
  EVENT
}

/**
 * Curated, kind-only reaction set (Kindness Always: nothing negative).
 * SUPPORT is the Community default; Wall Likes migrated to LOVE.
 */
enum Reaction {
  SUPPORT
  LOVE
  FIRE
  APPLAUSE
  INSPIRED
}

enum ReportTargetType {
  POST
  COMMENT
  COMMUNITY_POST
  USER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  image           String?
  role            Role      @default(VIEWER)
  /**
   * Supabase Auth `sub` — set when session comes from JWKS-verified JWT.
   */
  supabaseAuthId  String?   @unique
  /**
   * Community handle (lowercase). Artists mirror ArtistProfile.handle.
   */
  handle          String?   @unique
  bio             String?
  headline        String?
  location        String?
  /**
   * Optional "get paid directly" usernames for artists. Link-out only: TAP
   * processes nothing and takes no cut. Stored without the leading @ or $.
   */
  venmoUsername    String?
  cashAppTag       String?
  paypalMeUsername String?
  /**
   * Existing content chapter id (content.getChapters()); no FK yet.
   */
  chapterId       String?
  termsAcceptedAt DateTime?
  suspendedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  artistProfile ArtistProfile?
  posts         Post[]
  likes         Like[]
  comments      Comment[]

  topics             UserTopic[]
  following          Follow[]            @relation("Follower")
  followers          Follow[]            @relation("Following")
  blocksMade         Block[]             @relation("Blocker")
  blocksReceived     Block[]             @relation("Blocked")
  communityPosts     CommunityPost[]
  communityReactions CommunityReaction[]
  notifications      Notification[]      @relation("NotificationRecipient")
  notificationsActed Notification[]      @relation("NotificationActor")
  reportsFiled       Report[]
  eventsCreated      Event[]             @relation("EventCreator")
  eventRsvps         EventRsvp[]
  eventCheckIns      EventCheckIn[]

  @@index([role])
}

model ArtistProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  handle      String   @unique
  bio         String?
  avatarUrl   String?
  socialLinks Json?
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([handle])
  @@index([approved])
}

model Post {
  id          String     @id @default(cuid())
  authorId    String
  title       String
  slug        String     @unique
  description String?
  mediaUrl    String?
  mediaType   MediaType  @default(IMAGE)
  theme       Json?
  status      PostStatus @default(DRAFT)
  featured    Boolean    @default(false)
  viewCount   Int        @default(0)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags     Tag[]
  likes    Like[]
  comments Comment[]

  @@index([status, publishedAt])
  @@index([authorId])
  @@index([featured])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[]

  @@index([slug])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  /**
   * The emoji this like is. Existing likes are LOVE (the heart they always were).
   */
  reaction  Reaction @default(LOVE)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id        String    @id @default(cuid())
  body      String
  postId    String
  userId    String
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([actorId])
}

/**
 * Short-lived passwordless sign-in code (hashed). Join itself stays code-free like the website.
 */
model AuthChallenge {
  id         String               @id @default(cuid())
  email      String
  purpose    AuthChallengePurpose @default(SIGN_IN)
  codeHash   String
  attempts   Int                  @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime             @default(now())

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
}

/**
 * Curated, data-driven interest topics (genres + community themes).
 */
model Topic {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  kind      String   @default("genre")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users          UserTopic[]
  communityPosts CommunityPost[]
}

model UserTopic {
  userId    String
  topicId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
  @@index([topicId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model CommunityPost {
  id        String        @id @default(cuid())
  authorId  String
  kind      CommunityKind
  body      String
  imageUrl  String?
  topicId   String?
  parentId  String?
  hiddenAt  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  author    User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  topic     Topic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)
  parent    CommunityPost?      @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CommunityPost[]     @relation("Replies")
  reactions CommunityReaction[]

  @@index([parentId, createdAt])
  @@index([authorId, createdAt])
  @@index([topicId, createdAt])
  @@index([createdAt])
}

model CommunityReaction {
  userId    String
  postId    String
  /**
   * One reaction per person per post; changing it replaces the old one.
   */
  reaction  Reaction @default(SUPPORT)
  createdAt DateTime @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  actorId    String?
  targetKind String
  targetRef  String?
  preview    String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Report {
  id           String           @id @default(cuid())
  reporterId   String
  targetType   ReportTargetType
  targetId     String
  reason       String
  note         String?
  status       ReportStatus     @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
}

/// A night on the board, managed by admins. Public reads fall back to the
/// content service only for events that have no row here (see `sourceId`).
/// Times are absolute instants; `timeZone` is how the house reads them.
model Event {
  id             String      @id @default(cuid())
  /// Content-service event id this row supersedes (hides the seed entry).
  sourceId       String?     @unique
  title          String
  description    String      @default("")
  artist         String      @default("")
  medium         String      @default("community")
  startsAt       DateTime
  endsAt         DateTime
  timeZone       String      @default("America/New_York")
  venueName      String
  venueAddress   String?
  /// Optional venue point; only used to confirm a check-in is near the door.
  latitude       Float?
  longitude      Float?
  /// Total seats (sum of party sizes). Null = unlimited.
  capacity       Int?
  status         EventStatus @default(DRAFT)
  coverImageUrl  String?
  comingSoon     Boolean     @default(false)
  /// "Presented by" sponsor, disclosed plainly on the night. Admin-set only.
  /// No money field on purpose: artists and vendors never pay.
  sponsorName    String?
  /// https only; requires sponsorName.
  sponsorUrl     String?
  /// An upload from our own store (same rule as coverImageUrl); requires sponsorName.
  sponsorLogoUrl String?
  /// Food & vendors: [{ name, offering, url? }], at most 12. Admin-set only.
  vendors        Json        @default(dbgenerated("jsonb_build_array()"))
  createdById    String?
  publishedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  createdBy User?          @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  rsvps     EventRsvp[]
  checkIns  EventCheckIn[]

  @@index([status, startsAt])
}

model EventRsvp {
  id           String     @id @default(cuid())
  eventId      String
  userId       String
  status       RsvpStatus
  party        Int        @default(1)
  note         String?
  /// Set while a GOING response is waiting for a seat (FIFO by this time).
  waitlistedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId, createdAt])
}

/// "I'm here." Privacy: only the moment and whether the person was near the
/// venue are kept. No coordinates, accuracy or track are ever stored.
model EventCheckIn {
  id          String   @id @default(cuid())
  eventId     String
  userId      String
  checkedInAt DateTime @default(now())
  verified    Boolean  @default(false)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, checkedInAt])
}

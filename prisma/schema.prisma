generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VIEWER
  ARTIST
  ADMIN
}

enum MediaType {
  IMAGE
  VIDEO
  EMBED
  CANVAS
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AuthChallengePurpose {
  SIGN_IN
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  image           String?
  role            Role     @default(VIEWER)
  /** Supabase Auth `sub` — set when session comes from JWKS-verified JWT. */
  supabaseAuthId  String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  artistProfile ArtistProfile?
  posts         Post[]
  likes         Like[]
  comments      Comment[]

  @@index([role])
}

model ArtistProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  handle      String   @unique
  bio         String?
  avatarUrl   String?
  socialLinks Json?
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([handle])
  @@index([approved])
}

model Post {
  id          String     @id @default(cuid())
  authorId    String
  title       String
  slug        String     @unique
  description String?
  mediaUrl    String?
  mediaType   MediaType  @default(IMAGE)
  theme       Json?
  status      PostStatus @default(DRAFT)
  featured    Boolean    @default(false)
  viewCount   Int        @default(0)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags     Tag[]
  likes    Like[]
  comments Comment[]

  @@index([status, publishedAt])
  @@index([authorId])
  @@index([featured])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[]

  @@index([slug])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  postId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([actorId])
}

/** Short-lived passwordless sign-in code (hashed). Join itself stays code-free like the website. */
model AuthChallenge {
  id         String                @id @default(cuid())
  email      String
  purpose    AuthChallengePurpose  @default(SIGN_IN)
  codeHash   String
  attempts   Int                   @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime              @default(now())

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
}

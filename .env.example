# PostgreSQL — temp VPS Docker DB (framework for local wiring)
# Prod later: Neon / managed Postgres. Do not commit real passwords.
#
# VPS container: theartistpost-postgres on flux-vps (:5433)
# Compose: /opt/apps/theartistpost/docker-compose.yml
# Password lives on VPS: /opt/apps/theartistpost/.env (chmod 600)
#
# Direct (UFW-restricted to Flux Hub IP):
DATABASE_URL="postgresql://theartistpost:PASSWORD@2.25.206.39:5433/theartistpost?schema=public"
#
# Or SSH tunnel (more locked down — bind VPS to 127.0.0.1 only):
#   ssh -N -L 5433:127.0.0.1:5433 flux-vps
#   DATABASE_URL="postgresql://theartistpost:PASSWORD@127.0.0.1:5433/theartistpost?schema=public"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="The Artist Post"
CONTENT_ADAPTER="seed"

# GoHighLevel inbound webhook for Get Involved inquiries (fail closed in production)
# GHL_WEBHOOK_URL="https://services.leadconnectorhq.com/hooks/..."

# Flux Pulse — first-party traffic (pk_artistpost in flux-pulse/sites.json)
NEXT_PUBLIC_PULSE_URL="https://pulse.fluxlab.agency"
NEXT_PUBLIC_PULSE_KEY="pk_artistpost"

# Session cookie HMAC (passwordless join). Prefer AUTH_SECRET.
# Falls back to NEXTAUTH_SECRET if set. Production writes fail closed without one.
# Local/dev: if neither is set, a fixed non-production fallback is used.
AUTH_SECRET="generate-a-long-random-string"

# TODO: NextAuth — plug in when ready (passwordless / magic-link later)
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET=""
# Public join: /join (Member VIEWER or Artist pending). No OPERATOR_SECRET required.
# Invite approved artists (operator) via:
#   pnpm invite:artist -- --email real@example.com --handle handle --name "Real Name"
# or server action inviteArtistAction({ email, handle, name, operatorSecret }).

# Operator invite secret (required for invite:artist / inviteArtistAction only)
# OPERATOR_SECRET="generate-a-long-random-string"

# Optional: OPERATOR_UNLOCK=1 would unlock drafts-only create UI — not enabled.
# Create stays closed until ArtistProfile.approved = true.
